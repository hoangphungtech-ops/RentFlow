generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// RentFlow - model của Hiếu (H01, H02, H03, H04)
// Cách dùng: dán vào schema.prisma của dự án, GIỮ NGUYÊN phần
// generator và datasource do `prisma init` tạo (mỗi phiên bản
// Prisma cấu hình khác nhau). Sau đó chạy:
//   npx prisma format
//   npx prisma validate
//   npx prisma migrate dev --name init_hieu
// Các cột propertyId, leaseId, invoiceId, tenantId trỏ tới model
// của Vũ và Phùng: tạm để cột thường, thêm @relation khi gộp schema.
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
}

// Loại giao dịch: tên đề xuất, cần thống nhất với Phùng
enum TransactionType {
  INVOICE_PAYMENT
  DEPOSIT_OFFSET
  DEPOSIT_REFUND
}

model Role {
  id          String @id @default(uuid()) @db.Char(36)
  name        String @unique @db.VarChar(50)
  permissions Json
  users       User[]
}

model User {
  id             String               @id @default(uuid()) @db.Char(36)
  email          String               @unique @db.VarChar(255)
  passwordHash   String               @db.VarChar(255)
  fullName       String               @db.VarChar(100)
  phone          String?              @db.VarChar(20)
  status         UserStatus           @default(ACTIVE)
  // Tăng số này khi khóa tài khoản, đăng xuất hoặc đổi quyền: token cũ mất hiệu lực (thu hồi phiên)
  tokenVersion   Int                  @default(0)
  roleId         String               @db.Char(36)
  role           Role                 @relation(fields: [roleId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  propertyAccess UserPropertyAccess[]
  auditLogs      AuditLog[]
  payments       Payment[]
}

model UserPropertyAccess {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  propertyId String   @db.Char(36) // thêm @relation tới Property của Vũ khi gộp schema
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

// Chỉ ghi thêm: không có API sửa hoặc xóa
model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String   @db.Char(36)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(64)
  action     String   @db.VarChar(50)
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Payment {
  id              String              @id @default(uuid()) @db.Char(36)
  leaseId         String              @db.Char(36) // thêm @relation tới Lease của Phùng khi gộp schema
  transactionType TransactionType     @default(INVOICE_PAYMENT)
  amount          Decimal             @db.Decimal(12, 2)
  paymentMethod   String              @db.VarChar(20) // CASH hoặc BANK_TRANSFER, kiểm tra ở DTO
  payerName       String              @db.VarChar(100)
  paidAt          DateTime
  // Duy nhất khi có giá trị (MySQL cho phép nhiều dòng NULL)
  referenceCode   String?             @unique @db.VarChar(100)
  // Khóa chống gửi lại: cùng khóa thì chỉ có một giao dịch
  idempotencyKey  String?             @db.VarChar(100)
  status          PaymentStatus       @default(PENDING)
  recordedById    String              @db.Char(36)
  // Đảo giao dịch có lưu vết, không xóa
  reversedAt      DateTime?
  reversedById    String?             @db.Char(36)
  reversalReason  String?             @db.VarChar(500)
  createdAt       DateTime            @default(now())
  recordedBy      User                @relation(fields: [recordedById], references: [id])
  allocations     PaymentAllocation[]

  @@unique([recordedById, idempotencyKey])
  @@index([leaseId, status])
}

model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Char(36)
  paymentId       String   @db.Char(36)
  invoiceId       String   @db.Char(36) // thêm @relation tới Invoice của Vũ khi gộp schema
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// H03 - Lời mời người thuê: hết hạn, dùng một lần, gắn đúng người thuê
model Invitation {
  id          String    @id @default(uuid()) @db.Char(36)
  tokenHash   String    @unique @db.VarChar(64) // lưu băm SHA-256, không lưu token gốc
  tenantId    String    @db.Char(36)
  leaseId     String    @db.Char(36)
  createdById String    @db.Char(36)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// H03 - Tệp riêng tư: ảnh công tơ, bàn giao, minh chứng chuyển khoản
model FileAsset {
  id           String   @id @default(uuid()) @db.Char(36)
  entityType   String   @db.VarChar(50)
  entityId     String   @db.VarChar(64)
  uploadedById String   @db.Char(36)
  storageKey   String   @db.VarChar(255) // tên do hệ thống tạo, không dùng tên người dùng
  mimeType     String   @db.VarChar(50)
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}
