{
  "cli": { "appVersionSource": "local" },
  "build": {
    "internal": {
      "distribution": "internal",
      "channel": "internal",
      "env": { "RENTFLOW_RELEASE_BUILD": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": { "RENTFLOW_RELEASE_BUILD": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
